# Frontend settings (copy to .env). NEVER put secrets here: everything VITE_* is public in the built JavaScript.
#
# Leave VITE_API_URL empty to use same-origin /api:
#  - `npm run dev`: Vite proxies /api to VITE_DEV_PROXY_TARGET (below)
#  - Docker/production: nginx proxies /api to the API container
# Set it only if the API lives on a different origin (then add that frontend origin to the backend CORS_ORIGINS).
VITE_API_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
# Optional: map tile server (default is the public OpenStreetMap server - see its tile usage policy for production traffic)
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
