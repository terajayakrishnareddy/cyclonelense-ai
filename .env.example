# Docker deployment settings. Create the real file with:  python scripts/generate_env.py
# NEVER commit .env. Values below are intentionally empty: there are no default secrets.
POSTGRES_DB=cyclonelens
POSTGRES_USER=cyclonelens
POSTGRES_PASSWORD=            # URL-safe characters only (the generator uses letters/digits)
SECRET_KEY=                   # >= 32 random characters
CORS_ORIGINS=                 # public origin(s), e.g. https://cyclones.example.org (comma-separated, no wildcards)
WEB_BIND=127.0.0.1            # 0.0.0.0 only if nothing else terminates TLS in front
WEB_PORT=8080
ALLOW_REGISTRATION=true
ACCESS_TOKEN_MINUTES=60
ENABLE_DOCS=true
MAX_IMPORT_MB=500
LOG_LEVEL=INFO
