# Local development settings (copy to .env). NEVER commit .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./cyclonelens.db
# Leave empty in development to use a random per-process key, or set a persistent one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_REGISTRATION=true
UPLOAD_DIR=./uploads
MAX_IMPORT_MB=500
MAX_IMAGE_MB=20
LOG_LEVEL=INFO
